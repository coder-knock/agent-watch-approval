{
  "name": "agent-watch-approval",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Push L2/L3 tool calls to iPhone / Apple Watch — wrist-level approval before execution. L0/L1 silent-pass, L3 never auto-allows. Built on self-hosted Home Assistant; no third-party push.",
  "homepage": "https://watch-alert.coderknock.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/coder-knock/agent-watch-approval.git"
  },
  "bugs": {
    "url": "https://github.com/coder-knock/agent-watch-approval/issues"
  },
  "keywords": [
    "agent",
    "approval",
    "permission",
    "iphone",
    "apple-watch",
    "home-assistant",
    "hook",
    "claude-code",
    "mcp"
  ],
  "bin": {
    "approve-hook": "./bin/approve-hook.mjs",
    "approval-gateway": "./src/gateway.mjs",
    "approval-mcp": "./mcp/approval-mcp.mjs"
  },
  "scripts": {
    "start": "node src/gateway.mjs",
    "dev": "node src/gateway.mjs --config config.json",
    "selftest": "node test/selftest.mjs",
    "test:ha-channel": "node test/ha-channel.test.mjs",
    "test:risk": "node test/risk.test.mjs",
    "test:hook": "node test/hook.test.mjs",
    "test:mcp": "node test/mcp-e2e.mjs",
    "doctor": "node scripts/verify-ha.mjs doctor",
    "verify:ha": "node scripts/verify-ha.mjs link"
  },
  "engines": {
    "node": ">=20"
  }
}