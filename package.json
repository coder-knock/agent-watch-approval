{
  "name": "agent-approval",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "把 Agent 运行中需要确认的选项推到 iPhone / Apple Watch，腕上决策后回传给 Agent",
  "bin": {
    "approve-hook": "./bin/approve-hook.mjs",
    "approval-gateway": "./src/gateway.mjs",
    "approval-mcp": "./mcp/approval-mcp.mjs"
  },
  "scripts": {
    "start": "node src/gateway.mjs",
    "dev": "node src/gateway.mjs --config config.json",
    "selftest": "node test/selftest.mjs",
    "test:ha-channel": "node test/ha-channel.test.mjs",
    "test:risk": "node test/risk.test.mjs",
    "test:hook": "node test/hook.test.mjs",
    "test:mcp": "node test/mcp-e2e.mjs",
    "doctor": "node scripts/verify-ha.mjs doctor",
    "verify:ha": "node scripts/verify-ha.mjs link"
  },
  "engines": {
    "node": ">=20"
  }
}
